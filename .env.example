# ===================================================================
# Claw Dashboard — Environment Variables
# ===================================================================
# Copy this file to .env (Docker) or .env.local (local dev) and
# fill in the values before starting the application.
# ===================================================================

# --- Frontend (Vite — must be prefixed with VITE_) ---

# Agent data source API endpoint
VITE_API_BASE_URL=http://localhost:8080/api/v1

# WebSocket endpoint for realtime data
VITE_WS_URL=ws://localhost:8080/ws

# Default locale (zh-CN | en-US)
VITE_DEFAULT_LOCALE=zh-CN

# --- Docker Deployment ---

# TLS certificate paths (required for production)
TLS_CERT_PATH=./certs/server.crt
TLS_KEY_PATH=./certs/server.key

# PostgreSQL
POSTGRES_USER=claw
POSTGRES_PASSWORD=change_me_to_a_strong_password
POSTGRES_DB=claw_dashboard

# Redis
REDIS_PASSWORD=change_me_to_a_strong_password

# API secret key (used for agent data source auth, 32+ random chars)
API_SECRET_KEY=change_me_to_a_random_secret_key_32_chars
