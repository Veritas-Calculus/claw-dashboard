# ===================================================================
# Claw Dashboard — Environment Variables
# ===================================================================
# Copy to .env and adjust values before running docker compose up -d
# ===================================================================

# --- Exposed Ports ---
DASHBOARD_PORT=3000
PG_PORT=5432
REDIS_PORT=6379

# --- PostgreSQL ---
PG_PASSWORD=claw_secret

# --- Auth ---
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars

# --- Logging ---
RUST_LOG=claw_api=info,tower_http=info

# --- OpenClaw Gateway (optional) ---
# OPENCLAW_GATEWAY_URL=ws://your-openclaw-host:18789
# OPENCLAW_GATEWAY_TOKEN=your-gateway-token

# --- Dev/Demo only ---
# SEED_DATA=true
